# Copy to .env and fill in real values. .env is gitignored — never commit it.
#   PowerShell:  Copy-Item .env.example .env

# ---------------------------------------------------------------
# Hugging Face — required for pyannote diarization and embeddings.
# You must accept the terms for these gated repos on huggingface.co:
#   pyannote/speaker-diarization-3.1
#   pyannote/segmentation-3.0
#   pyannote/speaker-diarization-community-1
#   pyannote/embedding
# ---------------------------------------------------------------
HF_TOKEN=hf_your_real_token_here

# ---------------------------------------------------------------
# ASR (faster-whisper)
# large-v3 is the default for a reason: `medium` produced real
# transcription errors on Hindi / code-mixed audio during testing.
# ---------------------------------------------------------------
WHISPER_MODEL_SIZE=large-v3
WHISPER_DEVICE=cpu
WHISPER_COMPUTE_TYPE=int8

# ---------------------------------------------------------------
# Diarization + speaker embeddings (pyannote.audio 4.x)
# ---------------------------------------------------------------
DIARIZATION_MODEL=pyannote/speaker-diarization-3.1
EMBEDDING_MODEL=pyannote/embedding

# ---------------------------------------------------------------
# Local LLM (Ollama) — used for Hinglish normalization,
# summarization and action-item extraction.
# qwen2.5:7b handles Hindi/Devanagari noticeably better than llama3.1:8b.
# ---------------------------------------------------------------
OLLAMA_MODEL=qwen2.5:7b
OLLAMA_HOST=http://localhost:11434

# ---------------------------------------------------------------
# FFmpeg DLL directory (Windows only).
# Only needed if `meeting-assistant doctor` reports that the FFmpeg
# DLLs could not be found. It must point at the folder containing
# avcodec-*.dll — that means the SHARED FFmpeg build, not the static
# one. A static ffmpeg.exe on PATH satisfies `shutil.which` but has
# no DLLs, which is why auto-detection can appear to succeed and
# diarization still fails with OSError WinError 126.
#
# FFMPEG_BIN=C:\Users\rushi\AppData\Local\Microsoft\WinGet\Packages\Gyan.FFmpeg.Shared_Microsoft.Winget.Source_8wekyb3d8bbwe\ffmpeg-9.0.1-full_build-shared\bin
# ---------------------------------------------------------------

# ---------------------------------------------------------------
# Data root. Defaults to the repo-root `data/` directory.
# ---------------------------------------------------------------
DATA_DIR=data

# ---------------------------------------------------------------
# HTTP API and web UI (`meeting-assistant serve`).
# The server refuses to start without a token of at least 32
# characters. Generate one with:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
# Every route except /api/health requires it, including from the UI.
# ---------------------------------------------------------------
API_TOKEN=
# API_HOST=127.0.0.1          # 0.0.0.0 to reach it from other devices on the LAN
# API_PORT=8000
# API_CORS_ORIGINS=http://localhost:5173
# API_MAX_UPLOAD_MB=500
# API_MEDIA_TICKET_SEC=600     # lifetime of signed audio-playback URLs
# FRONTEND_DIST=frontend/dist  # built UI served at /
