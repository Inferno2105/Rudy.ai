# ---------------------------------------------------------------
# Secrets — never commit
# ---------------------------------------------------------------
.env
.env.local
token.txt
*.token

# ---------------------------------------------------------------
# Python
# ---------------------------------------------------------------
__pycache__/
*.py[cod]
*$py.class
*.egg-info/
build/
dist/
.pytest_cache/
.ruff_cache/
.mypy_cache/
.coverage
htmlcov/

# Virtual environments
venv/
venv312/
.venv/
env/

# ---------------------------------------------------------------
# Node / frontend
# ---------------------------------------------------------------
node_modules/
frontend/dist/
frontend/.vite/
*.local

# ---------------------------------------------------------------
# Archived pre-rebuild scratch code (kept on disk as reference only)
# ---------------------------------------------------------------
legacy/

# ---------------------------------------------------------------
# Data — audio and generated artifacts stay out of git.
# Eval references ARE committed (they are the project's evidence);
# see the negations at the end of this block.
# ---------------------------------------------------------------
*.wav
*.mp3
*.m4a
*.flac

data/runs/
data/experiments/
data/index.sqlite
data/index.sqlite-journal
data/users.sqlite
data/users.sqlite-journal
data/screenshots/

# Keep hand-labelled evaluation references and generated reports —
# small, and they are how published numbers stay reproducible.
!data/eval/references/
!data/eval/reports/
# ...except clips imported from a published corpus: its terms forbid
# redistribution (DISPLACE). Re-create them with `dataset import-displace`.
data/eval/references/displace-*/

# ---------------------------------------------------------------
# Paper artifacts are generated by `meeting-assistant paper build`,
# but committed so a reviewer can see them without a full re-run.
# ---------------------------------------------------------------
paper/**/*.aux
paper/**/*.log
paper/**/*.out
# LaTeX build outputs (the PDF is built from source, not committed)
paper/*.pdf
paper/*.bbl
paper/*.blg
paper/*.fls
paper/*.fdb_latexmk
paper/*.synctex.gz
paper/page-*.png

# ---------------------------------------------------------------
# Editors / OS
# ---------------------------------------------------------------
.vscode/
.idea/
*.swp
Thumbs.db
desktop.ini

# Office lock files (a document is open in Word)
~$*
